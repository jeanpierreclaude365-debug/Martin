rules_version = '2';

// Security rules for the Times Tables Fun shared leaderboard.
// Paste all of this into Firebase console -> Firestore Database -> Rules, then press Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Saved scores: anyone can read them and add a new one.
    // Nobody can change or delete a score from the game (you can, in the Firebase console).
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if validScore(request.resource.data);
      allow update, delete: if false;
    }

    // When today's champion was last reset (the red cross on the home screen).
    match /resets/{day} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at is int;
      allow delete: if false;
    }

    // The "Used" counter: it can only ever go up by one at a time.
    match /counters/opens {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }

    // A score must look exactly like one the game saves.
    // 'group' is optional: a class or family code of 4 to 8 letters and numbers.
    // Some letters can't be used as a name (the same list as BLOCKED_INITIALS in index.html).
    function validScore(d) {
      return d.keys().hasOnly(['initials', 'score', 'total', 'table', 'mode', 'quick', 'ms', 'day', 'at', 'group'])
        && d.keys().hasAll(['initials', 'score', 'total', 'table', 'mode', 'quick', 'ms', 'day', 'at'])
        && d.initials is string && d.initials.matches('^[A-Z]{1,3}$')
        && !(d.initials in ['ASS', 'BJ', 'CNT', 'COC', 'COK', 'CUM', 'DIK', 'FAG', 'FCK', 'FFS',
             'FU', 'FUC', 'FUK', 'FUQ', 'FUX', 'HOE', 'JIZ', 'KKK', 'KNB', 'KYS', 'NAZ', 'NGA', 'NGR', 'NIG', 'NOB',
             'PIS', 'SEX', 'SHT', 'SLT', 'TIT', 'TWT', 'VAG', 'WNK', 'WTF', 'XXX'])
        && ((d.mode == 'easy' && d.total == 5)
            || (d.mode == 'medium' && d.total == 10)
            || (d.mode == 'hard' && d.total == 20))
        && d.score is int && d.score >= 1 && d.score <= d.total
        && (d.table == 'mix' || (d.table is int && d.table >= 1 && d.table <= 1000000000000))
        && d.quick is bool
        && d.ms is int && d.ms >= 0 && d.ms < 86400000
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.at is int
        && (!('group' in d) || (d.group is string && d.group.matches('^[A-Z0-9]{4,8}$')));
    }
  }
}
